CREATE TABLE SessionTable (
    matricula TEXT NOT NULL PRIMARY KEY,
    password TEXT NOT NULL,
    is_logged_in INTEGER NOT NULL DEFAULT 0,
    last_login INTEGER NOT NULL DEFAULT 0
);

getSession:
SELECT * FROM SessionTable WHERE is_logged_in = 1;

sessionExists:
SELECT COUNT(*) FROM SessionTable WHERE is_logged_in = 1;

saveSession:
INSERT OR REPLACE INTO SessionTable(matricula, password, is_logged_in, last_login)
VALUES (?, ?, 1, ?);

clearSession:
DELETE FROM SessionTable;
